[Unit]
Description=Husker microVM manager daemon
After=network.target
Documentation=https://github.com/rvben/husker

[Service]
Type=simple
ExecStart=/usr/local/bin/husker daemon
Restart=on-failure
RestartSec=5

# Bound shutdown. The daemon stops in three phases, one after another: it gives
# in-flight API connections up to 20s to close, its background workers up to 5s
# to finish, then drains the guests, up to 45s (every guest is stopped
# concurrently under a 30s bound, plus the state bookkeeping around it). That is
# 70s in the worst case; this ceiling sits above it so systemd never SIGKILLs
# the daemon while guests are still flushing, yet a wedged stop cannot strand
# the unit indefinitely. A test in crates/husker holds this value above the
# daemon's constants.
TimeoutStopSec=90

# Signal only the daemon on stop. The default KillMode=control-group delivers
# the SIGTERM to every Firecracker/QEMU process in the unit at the same instant,
# so the guests die before the daemon's drain can ask them to flush and shut
# down, and whatever they had not synced is lost on every restart. With `mixed`
# the daemon alone receives the SIGTERM, stops every guest itself, and systemd
# SIGKILLs only what is still left once the daemon has exited.
KillMode=mixed

# Delegate the cgroup subtree so the daemon can create per-VM cgroups for the
# opt-in resource limits (memory.max / cpu.max). Harmless while limits are off;
# the daemon refuses to start with `resource_limits = true` without it.
Delegate=yes

# Hardening.
#
# NoNewPrivileges is left off because the daemon spawns the Firecracker/QEMU
# hypervisor and needs the ambient privileges to manage /dev/kvm, TAP devices,
# nftables, and cgroups. The directives below reduce blast radius without
# breaking those needs.
NoNewPrivileges=no
ProtectSystem=strict
ReadWritePaths=/var/lib/husker
RuntimeDirectory=husker
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true

# Intentionally NOT enabled (each would break a core function):
#   ProtectControlGroups=true   - the daemon writes cgroup.subtree_control to
#                                 enforce per-VM resource limits.
#   ProtectKernelTunables=true  - NAT setup toggles net.ipv4.ip_forward.
#   MemoryDenyWriteExecute=true - QEMU's TCG JIT needs W+X pages.
#   User=/CapabilityBoundingSet - the networking/KVM path currently assumes root;
#                                 a dedicated user + CAP_NET_ADMIN/CAP_NET_RAW is
#                                 a tracked follow-up (see the excellence audit).

[Install]
WantedBy=multi-user.target
