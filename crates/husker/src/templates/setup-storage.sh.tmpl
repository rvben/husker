#!/usr/bin/env bash
# husker setup storage - one-time migration of the husker data dir onto a
# reflink-capable loopback for instant copy-on-write clones.
#
# GENERATED by `husker setup storage`. Review before running. Run as ROOT on
# the husker daemon HOST with the daemon STOPPED. The original data dir is kept
# as a backup and is never deleted by this script.
set -euo pipefail

DATA_DIR="{{DATA_DIR}}"
STATE_DIR="{{STATE_DIR}}"
IMAGE_PATH="{{IMAGE_PATH}}"
SIZE="{{SIZE}}"
FS="{{FS}}"
CONFIG_FILE="{{CONFIG_FILE}}"
API_ADDR="{{API_ADDR}}"
PERSIST="{{PERSIST}}"

STAGING="${DATA_DIR}.staging"
BACKUP="${DATA_DIR}.pre-reflink.bak"
SENTINEL="${DATA_DIR}/.husker-storage-volume"
LOCK="${STATE_DIR}/husker.lock"

log() { printf '==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
flush() { sync; }  # full sync: flush all filesystems to disk before the next step

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ -d "$DATA_DIR" ] || die "data dir $DATA_DIR does not exist"

# STEP 1: stop-detection. A pre-Phase-A daemon never held the flock, so the
# lock alone is not proof; also require systemctl-inactive and an unreachable API.
mkdir -p "$STATE_DIR"
exec {lockfd}>"$LOCK"
flock -n "$lockfd" || die "state lock held: a husker daemon is running; stop it first"
if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files husker.service >/dev/null 2>&1; then
  ! systemctl is-active --quiet husker || die "husker.service is active; run: systemctl stop husker"
fi
if command -v curl >/dev/null 2>&1; then
  ! curl -fs -m 2 -o /dev/null "http://${API_ADDR}/v1/health" \
    || die "a daemon answers on ${API_ADDR}; stop it before migrating"
fi

# Idempotency: already a mounted storage volume? Nothing to do.
if [ -e "$SENTINEL" ] && mountpoint -q "$DATA_DIR"; then
  log "data dir is already a mounted husker storage volume; nothing to do"; exit 0
fi
[ -e "$BACKUP" ] && die "backup $BACKUP exists from a prior partial run; resolve it before re-running"
if mountpoint -q "$STAGING"; then umount "$STAGING"; fi

# STEP 2: write config BEFORE anything that could restart the daemon, so a
# restart picks up the new state_dir + storage_volume instead of creating a
# fresh DB under the (about-to-move) data dir.
[ -n "$CONFIG_FILE" ] || die "no managed config target; pass --state-dir and ensure $CONFIG_FILE exists"
mkdir -p "$(dirname "$CONFIG_FILE")"; touch "$CONFIG_FILE"
grep -q '^state_dir' "$CONFIG_FILE" || printf 'state_dir = "%s"\n' "$STATE_DIR" >> "$CONFIG_FILE"
grep -q '^storage_volume' "$CONFIG_FILE" || printf 'storage_volume = true\n' >> "$CONFIG_FILE"
log "wrote state_dir + storage_volume to $CONFIG_FILE"

# STEP 3: relocate state DB (+ WAL/SHM) and runtime to state_dir.
for f in husker.db husker.db-wal husker.db-shm; do
  if [ -e "${DATA_DIR}/${f}" ] && [ ! -e "${STATE_DIR}/${f}" ]; then
    mv "${DATA_DIR}/${f}" "${STATE_DIR}/${f}"
  fi
done
mkdir -p "${STATE_DIR}/run"
flush "$STATE_DIR"
log "relocated DB + runtime to $STATE_DIR"

# STEP 4: create + format the loopback (preallocated by default).
if [ ! -e "$IMAGE_PATH" ]; then
  {{ALLOC_LINE}}
  {{MKFS_LINE}}
  log "created loopback $IMAGE_PATH ($SIZE, $FS)"
fi

# STEP 5/6: stage-mount, copy bulk in, verify by checksum.
mkdir -p "$STAGING"
mountpoint -q "$STAGING" || mount -o loop "$IMAGE_PATH" "$STAGING"
log "copying data dir -> loopback (rsync -aHAXS)"
rsync -aHAXS --numeric-ids "${DATA_DIR}/" "${STAGING}/"
log "verifying copy (checksum)"
VERIFY_OUT="$(rsync -aHAXSn --numeric-ids --checksum "${DATA_DIR}/" "${STAGING}/")" || {
  umount "$STAGING"; die "verify rsync failed; aborting (data dir untouched)"
}
if [ -n "$VERIFY_OUT" ]; then
  umount "$STAGING"; die "copy verification found differences; aborting (data dir untouched)"
fi
flush "$STAGING"; umount "$STAGING"

# STEP 7: swap. Original kept as $BACKUP; mount the loopback at the data dir.
log "swapping in the loopback (original kept at $BACKUP)"
mv "$DATA_DIR" "$BACKUP"
mkdir -p "$DATA_DIR"; sync
mount -o loop "$IMAGE_PATH" "$DATA_DIR"
touch "$SENTINEL"
flush "$DATA_DIR"

# STEP 8: persist the mount across reboot.
if [ "$PERSIST" = "fstab" ]; then
  grep -qF "$IMAGE_PATH $DATA_DIR" /etc/fstab || printf '%s\n' "{{FSTAB_LINE}}" >> /etc/fstab
  log "added /etc/fstab entry"
else
  UNIT="$(systemd-escape -p --suffix=mount "$DATA_DIR")"
  cat > "/etc/systemd/system/${UNIT}" <<'UNITEOF'
{{SYSTEMD_UNIT}}
UNITEOF
  systemctl daemon-reload
  systemctl enable --now "$UNIT"
  if systemctl list-unit-files husker.service >/dev/null 2>&1; then
    mkdir -p /etc/systemd/system/husker.service.d
    cat > /etc/systemd/system/husker.service.d/10-storage-mount.conf <<DROPEOF
[Unit]
Requires=${UNIT}
After=${UNIT}
DROPEOF
    systemctl daemon-reload
  else
    log "WARNING: husker is not systemd-managed; the daemon mount guard is the only safety net. Ensure husker starts AFTER $DATA_DIR is mounted."
  fi
  log "installed + enabled systemd mount unit ${UNIT}"
fi

# STEP 9: done.
log "DONE. $DATA_DIR is now a reflink-capable $FS volume; new VM clones are copy-on-write."
log "ROLLBACK: systemctl stop husker; umount $DATA_DIR; rmdir $DATA_DIR; mv $BACKUP $DATA_DIR; remove the mount unit/fstab line + the config edits; start husker."
log "When satisfied: rm -rf $BACKUP"
